pipeline {
    agent any
    options { buildDiscarder(logRotator(numToKeepStr: '20')); disableConcurrentBuilds() }
    parameters {
        string(defaultValue: '', name: 'DIGEST', description: 'sha256:64-hex-digest immutable dari Nexus')
        string(defaultValue: '', name: 'SOURCE_IMAGE', description: 'Nama repo image (localhost:<port>/<app>)')
        string(defaultValue: '', name: 'RELEASE_ID', description: 'Namespace event deployment')
        string(defaultValue: '', name: 'BUILD_NUMBER_PARAM', description: 'Nomor build source')
        string(defaultValue: 'maliffadlan2', name: 'ACTOR', description: 'Login admin yang menekan Promosikan')
        string(defaultValue: '8000', name: 'CONTAINER_PORT', description: 'Port dalam container dummy (app.py: 8000)')
    }
    environment {
        APP_NAME = 'autore-dummy'
        DEPLOY_PORT = '8191'
        DEPLOY_SCRIPT = '/usr/local/lib/autore-ci/ci-deploy-by-digest.sh'
        AUTORE_BIN = '/usr/local/lib/autore-ci/autore'
        RESULT_JSON = '/usr/local/lib/autore-ci/.deploy-result.json'
        WORKSPACE_ROOT = '/home/tugure/autore-workspace'
    }
    stages {
        stage('Deploy Production By Digest') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-admin', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh '''
                        set -eu
                        export DOCKER_CONFIG="$(mktemp -d)"
                        rm -rf "$RESULT_JSON"
                        [ -n "$DIGEST" ] || { echo "ERROR: DIGEST wajib sha256:64-hex" >&2; exit 1; }
                        [ -n "$SOURCE_IMAGE" ] || { echo "ERROR: SOURCE_IMAGE wajib" >&2; exit 1; }
                        [ -n "$CONTAINER_PORT" ] || { echo "ERROR: CONTAINER_PORT wajib 1-65535; tes-testing/app harus di-set eksplisit" >&2; exit 1; }
                        case "$SOURCE_IMAGE" in *:*) REGISTRY="${SOURCE_IMAGE%%:*}" ;; *) REGISTRY="${SOURCE_IMAGE%%/*}" ;; esac
                        printf '%s' "$NEXUS_PASS" | docker login "$REGISTRY" -u "$NEXUS_USER" --password-stdin
                        "$DEPLOY_SCRIPT" "${SOURCE_IMAGE}@${DIGEST}"
                        echo '--- DEPLOY RESULT ---'
                        cat "$RESULT_JSON"
                    '''
                }
            }
        }
        stage('Record Aktif') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-admin', usernameVariable: '_U', passwordVariable: '_P')]) {
                    sh '''
                        set -eu
                        PROMOTE_ID="$("$AUTORE_BIN" release promote-id --app "$APP_NAME" --build "$BUILD_NUMBER_PARAM")"
                        COMMIT="${RELEASE_ID#"$APP_NAME":}"
                        COMMIT="${COMMIT%:*}"
                        "$AUTORE_BIN" release record --from-deploy-result "$RESULT_JSON" --app "$APP_NAME" --environment production --build "$BUILD_NUMBER_PARAM" --commit "$COMMIT" --id "$PROMOTE_ID" --actor "$ACTOR"
                    '''
                }
            }
        }
    }
    post { always { cleanWs() } }
}
