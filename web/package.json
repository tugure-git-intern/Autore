{
  "name": "autore-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:dashboard": "dotenv -e .env -- npm run dev --workspace @autore/dashboard",
    "dev:api": "npm run dev --workspace @autore/api",
    "build:dashboard": "dotenv -e .env -- npm run build --workspace @autore/dashboard",
    "start:dashboard": "dotenv -e .env -- npm run start --workspace @autore/dashboard",
    "start:api": "npm run start --workspace @autore/api",
    "test": "vitest",
    "test:e2e": "npm run test:e2e --workspace @autore/dashboard",
    "test:e2e:live": "E2E_LIVE=1 dotenv -e .env -- npm run test:e2e --workspace @autore/dashboard",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json && tsc --noEmit -p packages/contracts/tsconfig.json"
  },
  "devDependencies": {
    "dotenv-cli": "11.1.0",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.32",
    "@playwright/test": "1.65.0"
  }
}
