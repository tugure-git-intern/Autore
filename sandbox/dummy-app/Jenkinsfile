// Autore sandbox pipeline — proves the dedicated runner + DevSecOps Security Gate
// + Telegram Audit Report end-to-end:
// checkout → audit info → security gate (Code Guard + Gitleaks + Trivy) →
// build & test → deploy → smoke test → Telegram audit report.
pipeline {
    // Never on the controller: only nodes labelled `docker` (the runner) may run this.
    agent { label 'docker' }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    triggers {
        // Automatically check Git every minute; only triggers a build when new commits exist.
        pollSCM('* * * * *')
    }

    environment {
        APP_NAME    = 'autore-dummy'
        APP_DIR     = 'sandbox/dummy-app'
        DEPLOY_PORT = '8081'
    }

    stages {
        stage('Audit Info') {
            steps {
                script {
                    env.FAILED_STAGE  = 'Audit Info'
                    env.SHORT_SHA     = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG     = "build-${env.BUILD_NUMBER}-commit-${env.SHORT_SHA}"
                    env.AUDIT_AUTHOR  = sh(script: "git log -1 --pretty='%an <%ae>'", returnStdout: true).trim()
                    env.AUDIT_MESSAGE = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()
                    env.AUDIT_CAUSES  = currentBuild.getBuildCauses().collect { it.shortDescription }.join(', ')
                    echo """
==================== AUDIT ====================
Build      : #${env.BUILD_NUMBER}
Commit     : ${env.GIT_COMMIT}
Branch     : ${env.GIT_BRANCH}
Author     : ${env.AUDIT_AUTHOR}
Message    : ${env.AUDIT_MESSAGE}
Triggered  : ${env.AUDIT_CAUSES}
Runner     : ${env.NODE_NAME}
Image tag  : ${env.APP_NAME}:${env.IMAGE_TAG}
================================================"""
                }
            }
        }

        stage('Security Gate') {
            steps {
                script {
                    env.FAILED_STAGE = 'Security Gate (Secret & Code Scan)'
                }
                sh '''
                    if command -v autore >/dev/null 2>&1; then
                        autore scan --path "$APP_DIR"
                    elif [ -x /usr/local/bin/autore ]; then
                        /usr/local/bin/autore scan --path "$APP_DIR"
                    elif [ -x ./scripts/security-check.sh ]; then
                        ./scripts/security-check.sh
                    else
                        echo "🚫 [SECURITY GATE ERROR] Scanner 'autore' tidak ditemukan di sistem runner!" >&2
                        echo "Build DIBATALKAN demi keamanan (Fail-Closed / Default-Deny)." >&2
                        echo "Pastikan 'autore' terpasang secara global di runner (/usr/local/bin/autore)." >&2
                        exit 1
                    fi
                '''
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    env.FAILED_STAGE = 'Build & Test (Unit Test / Docker Build)'
                }
                // Unit tests run inside the Dockerfile's `test` stage; a failing test fails this stage.
                sh 'docker build --label "org.opencontainers.image.revision=$GIT_COMMIT" -t "$APP_NAME:$IMAGE_TAG" "$APP_DIR"'
            }
        }

        stage('Deploy (sandbox)') {
            steps {
                script {
                    env.FAILED_STAGE = 'Deploy (sandbox)'
                }
                sh '''
                    docker rm -f "$APP_NAME" >/dev/null 2>&1 || true
                    docker run -d --name "$APP_NAME" --restart unless-stopped \
                        -p "127.0.0.1:$DEPLOY_PORT:8000" "$APP_NAME:$IMAGE_TAG"
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    env.FAILED_STAGE = 'Smoke Test (/health)'
                }
                sh '''
                    for i in $(seq 1 10); do
                        if curl -fsS "http://127.0.0.1:$DEPLOY_PORT/health"; then
                            echo
                            exit 0
                        fi
                        sleep 1
                    done
                    echo "Smoke test failed: /health did not answer in 10s"
                    docker logs --tail 50 "$APP_NAME" || true
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            script {
                env.BUILD_STATUS = currentBuild.currentResult ?: 'SUCCESS'
                try {
                    withCredentials([
                        string(credentialsId: 'telegram-bot-token', variable: 'TELEGRAM_BOT_TOKEN')
                    ]) {
                        try {
                            withCredentials([
                                string(credentialsId: 'telegram-chat-id', variable: 'TELEGRAM_CHAT_ID')
                            ]) {
                                sh './scripts/notify-telegram.sh'
                            }
                        } catch (chatErr) {
                            // telegram-chat-id is optional: notify-telegram.sh will auto-detect it from getUpdates
                            sh './scripts/notify-telegram.sh'
                        }
                    }
                } catch (err) {
                    // Credentials not configured in Jenkins yet — still print full audit report to build log
                    sh './scripts/notify-telegram.sh'
                }
            }
            deleteDir()
        }
    }
}
