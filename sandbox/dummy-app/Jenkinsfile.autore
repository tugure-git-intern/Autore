// App buangan untuk menguji rollback by digest. Bukan aplikasi produksi:
// hanya hidup di port 8160, dipakai sekali saat memverifikasi Jenkinsfile.rollback
// + ci-deploy-by-digest.sh. Pipeline yang sama dengan app sungguhan (Shared Library
// 'autore'), supaya yang diuji benar-benar jalur deploy yang dipakai selanjutnya.
@Library('autore') _
autorePipeline(
    appName: 'uji-rollback',
    appPort: 8000,
    deployPort: 8160,
    // Nama container harus sama dengan yang dicari Jenkinsfile.rollback:
    // <app>-<environment>. Pipeline deploy memakai config.deployName, job rollback
    // menyusun namanya sendiri, jadi keduanya harus bertemu di sini.
    deployName: 'uji-rollback-staging',
    releaseEnvironment: 'staging',
    dockerfileDir: 'sandbox/dummy-app',
    // Project Sonar yang sudah ada: uji rollback tidak boleh menuntut setup baru.
    sonarProjectKey: 'autore-cli',
)
