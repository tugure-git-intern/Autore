[Unit]
Description=Autore web API (Hono status shim + action endpoints, loopback 127.0.0.1:9121)
Documentation=file:///home/tugure/Autore/web/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tugure/Autore/web
# Satu `.env` untuk dua unit: dashboard butuh auth, API butuh rahasia sesi yang
# sama. `-` = jangan gagal saat berkasnya belum ada, supaya urutan pemasangan
# tidak mematikan service.
EnvironmentFile=-/home/tugure/Autore/web/.env
Environment=NODE_ENV=production
# Aksi (deploy/scan) memakai dua variabel ini; tanpa workspace endpoint-nya
# menolak dengan 503, bukan menebak direktori. Target deploy tidak di sini:
# id aplikasi datang dari body request, karena tombol di dashboard selalu
# menunjuk aplikasi yang sedang dibuka.
Environment=AUTORE_BIN=/home/tugure/Autore/cli/target/release/autore
Environment=AUTORE_WORKSPACE=/home/tugure/autore-workspace
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run start:api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
