[Unit]
Description=Autore dashboard (Next.js production server, 0.0.0.0:9120)
Documentation=file:///home/tugure/Autore/web/README.md
Requires=autore-web-api.service
After=network-online.target autore-web-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tugure/Autore/web
# Sumber rahasia auth (GITHUB_ID/SECRET, NEXTAUTH_SECRET, NEXTAUTH_URL).
# `-` = jangan gagal kalau `.env` belum ada.
EnvironmentFile=-/home/tugure/Autore/web/.env
Environment=NODE_ENV=production
Environment=PATH=/home/tugure/.local/share/node22/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run start:dashboard
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
