# Autore dashboard + API — salin ke web/.env, dan JANGAN pernah commit .env
# Client ID/Secret dari GitHub OAuth App (akun tugure-git-intern)
GITHUB_ID=
GITHUB_SECRET=

# Rahasia cookie sesi — hasil `openssl rand -base64 32`
NEXTAUTH_SECRET=

# URL dashboard dari sudut pandang browser
NEXTAUTH_URL=http://100.80.3.14:9120

# Wajib di Auth.js v5 saat tidak jalan di localhost (di belakang tailnet)
AUTH_TRUST_HOST=true

# Whitelist tambahan, dipisah koma, bentuk `login:role` (role: dev|qa|admin;
# tanpa `:role` = admin). Kalau kosong -> pakai allowed-users.json (yang bisa
# disunting admin dari halaman Pengaturan /settings).
# PERINGATAN: kalau diisi, daftar ini MENIMPA allowed-users.json dan halaman
# Pengaturan jadi read-only (bisaDiubah:false).
AUTORE_ALLOWED_USERS=

# Jalur allowed-users.json kalau mau di luar repo. Kosong -> web/allowed-users.json.
AUTORE_ALLOWLIST_FILE=

# Org tujuan repo baru yang dibuat lewat dashboard (quick-start). Kosong -> repo
# lahir di akun GitHub pemilik token. Kolom Organisasi di form tetap menimpa nilai ini.
AUTORE_DEFAULT_ORG=
