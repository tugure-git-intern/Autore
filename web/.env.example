# Autore dashboard + API — salin ke web/.env, dan JANGAN pernah commit .env
# Client ID/Secret dari GitHub OAuth App (akun tugure-git-intern)
GITHUB_ID=
GITHUB_SECRET=

# Rahasia cookie sesi — hasil `openssl rand -base64 32`
NEXTAUTH_SECRET=

# URL dashboard dari sudut pandang browser
NEXTAUTH_URL=http://100.80.3.14:9120

# Wajib di Auth.js v5 saat tidak jalan di localhost (di belakang tailnet)
AUTH_TRUST_HOST=true

# Whitelist tambahan, dipisah koma. Kalau kosong -> pakai allowed-users.json
# Kalau diisi, Hono juga menolak 403 login yang tidak ada di daftar ini.
AUTORE_ALLOWED_USERS=
