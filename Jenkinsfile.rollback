// Jenkinsfile.rollback — rollback by digest, dipicu API (bukan SCM).
// Job ini tidak membangun dan tidak mempromosikan apa pun: port aktif dikembalikan
// ke digest lama, lalu fakta hasilnya dicatat CLI. Penulis event tetap skrip + CLI;
// proses API tidak menulis ledger.
//
// Registry: satu literal di sini saja. Pindahkan ke parameter job kalau registry
// pindah host.
def AUTORE_REGISTRY = '127.0.0.1:5000'
def AUTORE_BIN = '/usr/local/lib/autore-ci/autore'
def DEPLOY_SCRIPT = '/usr/local/lib/autore-ci/ci-deploy-by-digest.sh'

pipeline {
    agent { label 'vps-runner-1' }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    // Ledger yang dibaca API (deploy/autore-web-api.service). Tanpa baris ini CLI
    // menulis ke $HOME runner dan API tidak pernah melihat event rollback.
    environment {
        AUTORE_WORKSPACE = '/home/tugure/autore-workspace'
    }

    parameters {
        string(name: 'ROLLBACK_APP', defaultValue: '', description: 'Nama aplikasi')
        string(name: 'ROLLBACK_ENVIRONMENT', defaultValue: '', description: 'staging atau production')
        string(name: 'ROLLBACK_DIGEST', defaultValue: '', description: 'sha256:<64 hex> target rollback')
        string(name: 'ROLLBACK_DEPLOYMENT_ID', defaultValue: '', description: 'Deployment ID target rollback')
        string(name: 'ROLLBACK_RELEASE_ID', defaultValue: '', description: 'app:commit:build release yang di-rollback')
        string(name: 'ROLLBACK_ACTOR', defaultValue: '', description: 'Login pelaku rollback')
    }

    stages {
        stage('1. Validasi Parameter') {
            steps {
                script {
                    if (!params.ROLLBACK_ENVIRONMENT?.trim()) {
                        error('ROLLBACK_ENVIRONMENT wajib diisi: staging atau production')
                    }
                    if (!(params.ROLLBACK_ENVIRONMENT in ['staging', 'production'])) {
                        error("ROLLBACK_ENVIRONMENT tidak dikenal: ${params.ROLLBACK_ENVIRONMENT}. Isi staging atau production (huruf kecil).")
                    }
                    if (!(params.ROLLBACK_DIGEST ==~ /sha256:[0-9a-f]{64}/)) {
                        error("ROLLBACK_DIGEST bukan sha256:<64 hex>: ${params.ROLLBACK_DIGEST}")
                    }
                    if (!params.ROLLBACK_DEPLOYMENT_ID?.trim()) {
                        error('ROLLBACK_DEPLOYMENT_ID wajib diisi')
                    }
                    def bagian = (params.ROLLBACK_RELEASE_ID ?: '').tokenize(':')
                    if (bagian.size() != 3 || !(bagian[2] ==~ /\d+/)) {
                        error("ROLLBACK_RELEASE_ID harus berbentuk app:commit:build, diterima: ${params.ROLLBACK_RELEASE_ID}")
                    }
                }
            }
        }

        stage('2. Rollback by Digest') {
            steps {
                // Nilai Groovy dialirkan lewat environment, bukan interpolasi GString:
                // di dalam GString Groovy, "${...}" milik shell harus di-escape dan
                // escape itu justru ditolak parser (illegal string body character).
                // Blok sh di bawah memakai kutip tunggal, jadi isinya murni shell.
                withEnv([
                    "DEPLOY_SCRIPT=${DEPLOY_SCRIPT}",
                    "AUTORE_BIN=${AUTORE_BIN}",
                    "AUTORE_REGISTRY=${AUTORE_REGISTRY}",
                    "RB_APP=${params.ROLLBACK_APP}",
                    "RB_ENV=${params.ROLLBACK_ENVIRONMENT}",
                    "RB_DIGEST=${params.ROLLBACK_DIGEST}",
                    "RB_DEPLOYMENT_ID=${params.ROLLBACK_DEPLOYMENT_ID}",
                    "RB_RELEASE_ID=${params.ROLLBACK_RELEASE_ID}",
                    "RB_ACTOR=${params.ROLLBACK_ACTOR}",
                ]) {
                    sh '''#!/bin/sh
                    set -e
                    if [ ! -x "$DEPLOY_SCRIPT" ]; then
                      echo "ERROR: $DEPLOY_SCRIPT tidak ada atau tidak executable (milik admin runner)" >&2
                      exit 1
                    fi
                    if [ ! -x "$AUTORE_BIN" ]; then
                      echo "ERROR: $AUTORE_BIN tidak ada atau tidak executable (milik admin runner)" >&2
                      exit 1
                    fi

                    export AUTORE_DEPLOY_MODE=rollback
                    export APP_NAME="$RB_APP"
                    export ACTIVE_CONTAINER_NAME="$RB_APP-$RB_ENV"
                    export CANDIDATE_CONTAINER_NAME="$ACTIVE_CONTAINER_NAME-candidate"
                    export DEPLOYMENT_ID="$RB_DEPLOYMENT_ID"
                    export RESULT_JSON="$WORKSPACE/.deploy-rollback-result.json"

                    image_ref="$AUTORE_REGISTRY/$RB_APP@$RB_DIGEST"
                    set +e
                    "$DEPLOY_SCRIPT" "$image_ref"
                    deploy_code=$?
                    set -e

                    if [ -f "$RESULT_JSON" ]; then
                      build=$(echo "$RB_RELEASE_ID" | cut -d: -f3)
                      id=$("$AUTORE_BIN" release rollback-id --app "$RB_APP" --build "$build")
                      "$AUTORE_BIN" release record \
                        --from-deploy-result "$RESULT_JSON" \
                        --app "$RB_APP" \
                        --environment "$RB_ENV" \
                        --build "$build" \
                        --commit "$(echo "$RB_RELEASE_ID" | cut -d: -f2)" \
                        --request-id "$RB_RELEASE_ID" \
                        --id "$id" \
                        --actor "$RB_ACTOR" >/dev/null
                    fi

                    exit "$deploy_code"
                    '''
                }
            }
        }

    post {
        always {
            echo "POST-ALWAYS: result=${currentBuild.currentResult}, app=${params.ROLLBACK_APP}, env=${params.ROLLBACK_ENVIRONMENT}, digest=${params.ROLLBACK_DIGEST}"
        }
    }
}
